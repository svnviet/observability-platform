# Connection string for this service's own PostgreSQL database. Use the postgresql+psycopg:// scheme.
# Required: the process refuses to run migrations or serve queries without it.
OBSKIT_PLATFORM_DATABASE_URL=postgresql+psycopg://obs:change-me@localhost:5432/observability

# Shared secret every caller (SDKs, UI backend) sends as the X-API-Key header.
# Required: the process fails at boot if unset, so it can never serve unauthenticated.
OBSKIT_PLATFORM_API_KEY=change-me

# Page size when a list endpoint gets no `limit`. Default 50.
OBSKIT_PLATFORM_DEFAULT_PAGE_SIZE=50

# Hard cap on `limit` for list endpoints, so one request cannot dump a whole history table. Default 200.
OBSKIT_PLATFORM_MAX_PAGE_SIZE=200

# Seconds without a heartbeat before a service instance or worker is marked UNHEALTHY and an incident opens. Default 30.
OBSKIT_PLATFORM_HEARTBEAT_TIMEOUT_S=30

# How often the background monitor scans for missed heartbeats. 0 disables the scan. Default 10.
OBSKIT_PLATFORM_HEARTBEAT_SCAN_INTERVAL_S=10

# Seconds an UNHEALTHY instance/worker stays silent before it is presumed gone and marked STOPPED (its incident
# closes). Catches processes killed without a clean shutdown. 0 disables. Default 86400 (24 h).
OBSKIT_PLATFORM_LOST_AFTER_S=86400

# Seconds a STOPPED instance/worker stays silent before it is deleted, so dead registrations do not pile up.
# Jobs and incidents are kept. 0 keeps everything forever. Default 604800 (7 days).
OBSKIT_PLATFORM_PURGE_AFTER_S=604800

# Seconds between active probes of every instance's health_url (set at register as metadata.health_url, or via
# PUT /services/{id}/instances/{instance_id}/health-url). 0 disables active probing. Default 30.
OBSKIT_PLATFORM_HEALTH_PROBE_INTERVAL_S=30

# Seconds to wait for a health response before the probe counts as failed. Default 5.
OBSKIT_PLATFORM_HEALTH_PROBE_TIMEOUT_S=5

# Consecutive failed probes that open an incident and count as an outage. Default 3.
OBSKIT_PLATFORM_HEALTH_FAIL_THRESHOLD=3

# Days of probe history to keep (the basis for uptime and capacity figures). 0 keeps everything. Default 14.
OBSKIT_PLATFORM_HEALTH_RETENTION_DAYS=14

# Where a job's logs live, so the UI and GET /jobs/{id}/observability can link to them. Placeholders (URL-encoded):
# {trace_id} {job_id} {service} {worker} {workflow_id}. A link needs every placeholder it uses to have a value.
# Leave unset if you run no log backend: the log link is then reported as not available.
OBSKIT_PLATFORM_LOGS_URL_TEMPLATE=

# Same for a service's metrics dashboard, e.g. http://localhost:8080/d/service?service={service}.
# When unset the link falls back to OBSKIT_PLATFORM_PERSES_URL, or the Prometheus URL if that is unset too.
OBSKIT_PLATFORM_METRICS_URL_TEMPLATE=

# Browser-facing URLs of the trace and dashboard tools. When set, workflow runs and attempts carry a link to
# their trace in Jaeger and the UI links to Perses. Leave unset if you do not run them.
OBSKIT_PLATFORM_JAEGER_URL=http://localhost:16686
OBSKIT_PLATFORM_PERSES_URL=http://localhost:8080
OBSKIT_PLATFORM_PROMETHEUS_URL=http://localhost:9090
